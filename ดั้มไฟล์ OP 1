-- ==================== UTILITIES ====================
local function getRemotePath(obj)
   local path = obj.Name
   local parent = obj.Parent
   while parent and parent ~= game do
       path = parent.Name .. "." .. path
       parent = parent.Parent
   end
   return path
end

local function formatArgs(args)
   local parts = {}
   for i, v in ipairs(args) do
       local t = typeof(v)
       if t == "Instance" then
           parts[i] = string.format("%s(%s)", t, v.Name)
       elseif t == "table" then
           parts[i] = string.format("table[%d]", #v)
       elseif t == "string" then
           local s = v:gsub("\n", "\\n"):sub(1, 40)
           parts[i] = '"' .. s .. '"'
       elseif t == "number" then
           parts[i] = string.format("%.3f", v)
       else
           parts[i] = tostring(v)
       end
   end
   return table.concat(parts, ", ")
end

local function safeWriteFile(name, content)
   if not writefile then return false end
   pcall(function()
       if not isfolder("TigerDumper") then
           makefolder("TigerDumper")
       end
       writefile("TigerDumper/" .. name, content)
   end)
   return true
end

-- ==================== REMOTE SCANNER ====================
local function scanAllRemotes()
   local found = {}
   local function scan(parent)
       for _, obj in ipairs(parent:GetDescendants()) do
           if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") or obj:IsA("UnreliableRemoteEvent") then
               table.insert(found, {
                   Name = obj.Name,
                   Class = obj.ClassName,
                   Path = getRemotePath(obj),
                   ParentName = obj.Parent and obj.Parent.Name or "nil"
               })
           end
       end
   end
   scan(rs)
   scan(workspace)
   return found
end

-- ==================== REMOTE SPY (HOOK) ====================
local function installSpyHook()
   if DumperConfig.hookInstalled then return end
   if not hookmetamethod then return end
   
   local ok, mt = pcall(getrawmetatable, game)
   if not ok or not mt then return end
   
   local oldNamecall = mt.__namecall
   if not oldNamecall then return end
   
   pcall(function() setreadonly(mt, false) end)
   
   mt.__namecall = newcclosure(function(self, ...)
       local args = {...}
       local method = getnamecallmethod()
       
       if DumperConfig.spyEnabled and typeof(self) == "Instance" then
           if method == "FireServer" or method == "InvokeServer" then
               if self:IsA("RemoteEvent") or self:IsA("RemoteFunction") or self:IsA("UnreliableRemoteEvent") then
                   local entry = {
                       Time = os.date("%H:%M:%S"),
                       Remote = self.Name,
                       Class = self.ClassName,
                       Method = method,
                       Args = formatArgs(args),
                       Path = getRemotePath(self)
                   }
                   table.insert(remoteLogs, 1, entry)
                   if #remoteLogs > DumperConfig.maxLogs then
                       table.remove(remoteLogs)
                   end
                   
                   if DumperConfig.logToFile then
                       local line = string.format("[%s] %s.%s(%s) [%s]\n", entry.Time, entry.Remote, entry.Method, entry.Args, entry.Class)
                       pcall(function()
                           local path = "TigerDumper/RemoteSpy_Logs.txt"
                           local existing = isfile(path) and readfile(path) or ""
                           writefile(path, line .. existing)
                       end)
                   end
               end
           end
       end
       
       return oldNamecall(self, ...)
   end)
   
   pcall(function() setreadonly(mt, true) end)
   DumperConfig.hookInstalled = true
end

-- ==================== SCRIPT EXPLORER ====================
local function scanAllScripts()
   local list = {}
   for _, obj in ipairs(game:GetDescendants()) do
       if obj:IsA("LocalScript") or obj:IsA("ModuleScript") or obj:IsA("Script") then
           table.insert(list, {
               Name = obj.Name,
               Class = obj.ClassName,
               Path = obj:GetFullName()
           })
       end
   end
   return list
end

