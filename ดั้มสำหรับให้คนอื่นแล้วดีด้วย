-- ==================== UTILITIES ====================
local function getInstancePath(obj)
    if not obj then return "nil" end
    local success, path = pcall(function()
        return obj:GetFullName()
    end)
    return success and path or tostring(obj)
end

local function formatValue(v)
    local t = typeof(v)
    if t == "Instance" then
        return string.format("Instance(%s)", v.Name)
    elseif t == "table" then
        local count = 0
        for _ in pairs(v) do count = count + 1 end
        return string.format("table[%d]", count)
    elseif t == "string" then
        return '"' .. v:gsub("\n", "\\n"):sub(1, 30) .. '"'
    elseif t == "number" then
        return string.format("%.2f", v)
    else
        return tostring(v)
    end
end

local function formatArgs(args)
    local parts = {}
    for i, v in ipairs(args) do
        parts[i] = formatValue(v)
    end
    return table.concat(parts, ", ")
end

local function safeWriteFile(name, content)
    if not Capabilities.writefile then return false end
    return pcall(function()
        if Capabilities.makefolder and not isfolder("TigerDumper") then
            makefolder("TigerDumper")
        end
        writefile("TigerDumper/" .. name, content)
    end)
end

-- ==================== DISCORD SENDER ====================
local function sendToDiscord(fileName, fileContent, titleMessage)
    if not Config.webhookUrl or Config.webhookUrl == "" then 
        return false, "กรุณาระบุ Webhook URL ก่อน" 
    end
    if not Capabilities.httpRequest then 
        return false, "Executor ไม่รองรับ HTTP Request" 
    end

    -- Chunking: ตัดไฟล์ละ 4MB เพื่อเซฟ Bandwidth และไม่ชน Discord 8MB Limit
    local maxChunk = 4 * 1024 * 1024
    if #fileContent > maxChunk then
        local totalParts = math.ceil(#fileContent / maxChunk)
        for idx = 1, totalParts do
            local start = (idx - 1) * maxChunk + 1
            local finish = math.min(idx * maxChunk, #fileContent)
            local part = fileContent:sub(start, finish)
            local pName = fileName:gsub("%.%w+$", "") .. "_p" .. idx .. ".txt"
            sendToDiscord(pName, part, string.format("%s [%d/%d]", titleMessage or "Tiger Dumper", idx, totalParts))
            task.wait(1)
        end
        return true
    end

    local boundary = "----TigerBoundary" .. httpService:GenerateGUID(false):gsub("-", "")
    local body = "--" .. boundary .. "\r\n"
        .. 'Content-Disposition: form-data; name="content"\r\n\r\n'
        .. (titleMessage or "📦 Tiger Dumper Export") .. "\r\n"
        .. "--" .. boundary .. "\r\n"
        .. 'Content-Disposition: form-data; name="file"; filename="' .. fileName .. '"\r\n'
        .. "Content-Type: text/plain\r\n\r\n"
        .. fileContent .. "\r\n"
        .. "--" .. boundary .. "--\r\n"

    local ok, res = pcall(function()
        return httpRequest({
            Url = Config.webhookUrl,
            Method = "POST",
            Headers = { ["Content-Type"] = "multipart/form-data; boundary=" .. boundary },
            Body = body
        })
    end)

    if ok and res and (res.StatusCode == 200 or res.StatusCode == 204) then
        return true
    else
        return false, res and tostring(res.StatusCode) or "ส่งไม่สำเร็จ"
    end
end

-- ==================== SAFE SCANNER ====================
-- ระบุ Container ปลอดภัย แทนการยิง game:GetDescendants() มั่ว
local SAFE_CONTAINERS = {
    workspace,
    rs,
    game:GetService("ReplicatedFirst"),
    lp:WaitForChild("PlayerScripts", 2),
    lp:WaitForChild("PlayerGui", 2)
}

local function getSafeTargets()
    local list = {}
    for _, service in ipairs(SAFE_CONTAINERS) do
        if service then table.insert(list, service) end
    end
    return list
end

local function scanRemotes(limit)
    limit = limit or 300
    local found = {}
    for _, container in ipairs(getSafeTargets()) do
        for _, obj in ipairs(container:GetDescendants()) do
            if #found >= limit then return found end
            if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") or (pcall(function() return obj:IsA("UnreliableRemoteEvent") end) and obj:IsA("UnreliableRemoteEvent")) then
                table.insert(found, { Name = obj.Name, Class = obj.ClassName, Path = getInstancePath(obj) })
            end
        end
    end
    return found
end

local function scanScripts(limit)
    limit = limit or 300
    local found = {}
    for _, container in ipairs(getSafeTargets()) do
        for _, obj in ipairs(container:GetDescendants()) do
            if #found >= limit then return found end
            if obj:IsA("LocalScript") or obj:IsA("ModuleScript") then
                table.insert(found, { Name = obj.Name, Class = obj.ClassName, Path = getInstancePath(obj) })
            end
        end
    end
    return found
end

-- ==================== SPY HOOK ====================
local function installSpyHook()
    if Config.hookInstalled or not Capabilities.hookmetamethod then return end
    local ok, mt = pcall(getrawmetatable, game)
    if not ok or not mt then return end
    
    local oldNamecall
    oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
        local method = getnamecallmethod()
        if Config.spyEnabled and typeof(self) == "Instance" then
            if method == "FireServer" or method == "InvokeServer" then
                local args = {...}
                task.spawn(function()
                    table.insert(State.remoteLogs, 1, {
                        Time = os.date("%H:%M:%S"),
                        Remote = self.Name,
                        Method = method,
                        Args = formatArgs(args),
                        Path = getInstancePath(self)
                    })
                    if #State.remoteLogs > Config.maxLogs then 
                        table.remove(State.remoteLogs) 
                    end
                end)
            end
        end
        return oldNamecall(self, ...)
    end))
    Config.hookInstalled = true
end

