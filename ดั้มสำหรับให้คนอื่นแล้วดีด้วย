            local ok, err = sendToDiscord("DumpedScripts.lua", dump, string.format("⚡ แกะสำเร็จ %d สคริปต์", count))
            Window:Dialog({
                Title = ok and "✅ สำเร็จ" or "❌ ล้มเหลว",
