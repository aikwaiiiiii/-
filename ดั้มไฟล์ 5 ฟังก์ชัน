pcall(function() pg.TigerRootGui:Destroy() end)

local http = (syn and syn.request) or http_request or (fluxus and fluxus.request) or request
local hook = ""

local function post(name, data)
    if hook == "" or not http then return end
    local b = "----TB" .. tick()
    local body = "--"..b.."\r\nContent-Disposition: form-data; name=\"file\"; filename=\""..name.."\"\r\nContent-Type: text/plain\r\n\r\n"..data.."\r\n--"..b.."--"
    pcall(function()
        http({Url = hook, Method = "POST", Headers = {["Content-Type"] = "multipart/form-data; boundary="..b}, Body = body})
    end)
end

local function f1()
    local s = "=== WORKSPACE TREE ===\n"
    for _, v in ipairs(workspace:GetChildren()) do
        if v:IsA("Folder") or v:IsA("Model") then
            s = s .. string.format("[%s] %s (Children: %d)\n", v.ClassName, v.Name, #v:GetChildren())
        end
    end
    return s
end

local function f2()
    local s, count = "=== TARGETS DUMP ===\n", 0
    local keys = {"egg","drop","plot","spawn","crate","chest","shop","chicken","duck","block","zone"}
    for _, v in ipairs(workspace:GetChildren()) do
        local n = v.Name:lower()
        for _, k in ipairs(keys) do
            if n:find(k, 1, true) then
                local pos = v:IsA("BasePart") and tostring(v.Position) or (v:IsA("Model") and v.PrimaryPart and tostring(v.PrimaryPart.Position)) or "N/A"
                s = s .. string.format("[%s] %s | Pos: %s\nPath: %s\n\n", v.ClassName, v.Name, pos, v:GetFullName())
                count = count + 1; break
            end
        end
        if count >= 60 then break end
    end
    return s
end

local function f3()
    local s = "=== REMOTES LIST ===\n"
    for _, v in ipairs(game:GetService("ReplicatedStorage"):GetDescendants()) do
        if v:IsA("RemoteEvent") or v:IsA("RemoteFunction") then
            s = s .. string.format("[%s] %s\nPath: %s\n\n", v.ClassName, v.Name, v:GetFullName())
        end
    end
    return s
end

local function f4()
    local s = "=== PLAYER STATS ===\n"
    for _, n in ipairs({"leaderstats","Data","Stats","values"}) do
        local d = p:FindFirstChild(n)
        if d then
            s = s .. "Folder: " .. n .. "\n"
            for _, v in ipairs(d:GetChildren()) do
                if v:IsA("ValueBase") then s = s .. string.format("  %s = %s\n", v.Name, tostring(v.Value)) end
            end
        end
    end
    return s
end

